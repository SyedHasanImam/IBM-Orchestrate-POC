# Copy this file to .env and fill in real values. Never commit .env itself.

# ── LLM Provider (Google Gemini via Google AI Studio) ──────────────────
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Model routing — per-agent-role model selection (used with init_chat_model)
AGGREGATION_MODEL=google_genai:gemini-3.1-flash-lite
COMPLIANCE_MODEL=google_genai:gemini-3.5-flash
REPORTING_MODEL=google_genai:gemini-3.5-flash-lite
EMBEDDING_MODEL=google_genai:gemini-embedding-001

# ── Postgres (Neon) — LangGraph checkpointer, audit log, agent registry ─
DATABASE_URL=postgresql://user:password@ep-example-xxxx.neon.tech/dbname?sslmode=require

# ── Langfuse (observability, cloud free tier) ───────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Vector DB (Chroma) — local/embedded, no credentials needed ──────────
CHROMA_PERSIST_DIR=./data/chroma

# ── App / runtime ────────────────────────────────────────────────────────
ENVIRONMENT=development
